{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitmaps:projection:v1",
  "title": "gitmaps.projection/v1",
  "description": "Public, signed region file. The bytes must equal canonical_bytes() of the parsed value (src/canonical.rs). Rules a JSON Schema cannot express are enforced by src/projection/schema.rs, which is authoritative: requires must name quests in the same file and be acyclic; quest ids are unique; contributors.handles has at most contributors.count items; source_as_of <= generated_at < expires_at; state_since is not after generated_at; dates and times are real calendar values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "region", "key_id", "sequence", "generated_at", "source_as_of", "expires_at", "quests"],
  "properties": {
    "schema": { "const": "gitmaps.projection/v1" },
    "region": { "$ref": "#/$defs/region" },
    "key_id": { "type": "string", "pattern": "^k-[0-9a-f]{16}$", "description": "Selects a pinned public key." },
    "sequence": { "type": "integer", "minimum": 1, "description": "Monotonic per region." },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "source_as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00Z$",
      "description": "Latest source update, rounded down to the hour."
    },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "quests": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/quest" } }
  },
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "display_name"],
      "properties": {
        "region_id": { "type": "string", "pattern": "^r-[0-9a-f]{16}$", "description": "Random; not derived from any repository identifier." },
        "display_name": { "$ref": "#/$defs/text", "maxLength": 60, "pattern": "\\S" }
      }
    },
    "text": {
      "type": "string",
      "description": "No control characters and no bidirectional overrides or isolates.",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
    },
    "tags": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["accessibility", "backend", "ci", "data", "docs", "frontend", "infrastructure", "security", "testing"] }
    },
    "quest_id": { "type": "string", "pattern": "^q-[0-9a-f]{16}$" },
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quest_id", "title", "summary", "state", "state_since", "requires", "hidden_prerequisites", "contributors", "join_open"],
      "properties": {
        "quest_id": { "$ref": "#/$defs/quest_id" },
        "title": { "$ref": "#/$defs/text", "maxLength": 80, "pattern": "\\S" },
        "summary": { "$ref": "#/$defs/text", "maxLength": 400 },
        "tags": { "$ref": "#/$defs/tags" },
        "state": { "enum": ["DISCOVERED", "LOCKED", "CLAIMED", "PROVEN", "RETIRED"], "description": "INVALID is never published." },
        "state_since": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "requires": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/quest_id" } },
        "hidden_prerequisites": { "type": "boolean", "description": "A blocking dependency exists that is not approved for publication." },
        "contributors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "handles"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "handles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$" } }
          }
        },
        "join_open": { "type": "boolean" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commitment"],
          "properties": { "commitment": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        }
      },
      "if": { "properties": { "state": { "const": "PROVEN" } } },
      "then": { "required": ["provenance"] },
      "else": { "not": { "required": ["provenance"] } }
    }
  }
}
